{
  "name": "@akashic-contents/explosive-ohajiki-chain",
  "private": true,
  "version": "1.1.1",
  "description": "ぶっこわしカーリング",
  "author": "DWANGO Co., Ltd.",
  "license": "MIT",
  "scripts": {
    "build": "rimraf ./script && tsc && akashic scan asset script",
    "update": "akashic scan asset && akashic scan globalScripts",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "start": "akashic sandbox .",
    "serve": "akashic serve --target-service nicolive .",
    "export-zip": "mkdirp dist/zip && akashic export zip -o dist/zip/game.zip --target-service nicolive --minify --hash-filename --force",
    "export-html": "rimraf dist/html && akashic export html -o dist/html",
    "stat": "akashic stat size",
    "test": "jest",
    "relock": "find node_modules/@akashic -name npm-shrinkwrap.json -delete && rimraf package-lock.json && npm install --package-lock-only && npm install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akashic-contents/explosive-ohajiki-chain.git"
  },
  "devDependencies": {
    "@akashic/akashic-cli": "^3.0.28",
    "@akashic/akashic-engine": "^3.21.1",
    "@eslint/js": "^9.17.0",
    "@multi-indiegame/akashic-player-ban-serve": "^1.1.0",
    "@multi-indiegame/akashic-scoreboard-serve-coe": "^0.1.0",
    "eslint": "^9.17.0",
    "jest": "^30.2.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2"
  },
  "dependencies": {
    "@akashic-extension/akashic-timeline": "^3.2.2",
    "@akashic-extension/coe": "^2.3.0",
    "@akashic-extension/resolve-player-info": "^1.3.0",
    "@multi-indiegame/akashic-player-ban": "^1.1.0",
    "@multi-indiegame/akashic-player-ban-coe": "^1.0.0",
    "@multi-indiegame/akashic-scoreboard": "^1.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver": true
  },
  "overrides": {
    "ws": "8.21.3",
    "tar": "7.5.22",
    "socket.io-parser": "4.2.7",
    "rollup": "4.59.0",
    "qs": "6.16.0",
    "minimatch": "10.2.3",
    "lodash": "4.18.0",
    "file-type": "21.3.2",
    "decode-uri-component": "0.5.0",
    "cookie": "0.7.0",
    "@babel/core": "7.29.7",
    "engine.io": "6.6.7",
    "music-metadata": "11.12.3"
  }
}
